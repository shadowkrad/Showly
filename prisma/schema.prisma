datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String
  nome                String          @default("Esercente")
  ruolo               String          @default("ESERCENTE") // "ESERCENTE" | "STAFF"
  mustChangePassword  Boolean         @default(false)

  // Hardening Sicurezza v1.0.6
  mfaEnabled          Boolean         @default(false)
  mfaSecret           String?         // Secret TOTP Base32 RFC 6238
  mfaBackupCodes      String?         // JSON array con 8 codici hash-ati
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int             @default(1)

  trustedDevices      TrustedDevice[]
  accessLogs          AccessLog[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Impostazioni {
  id              String   @id @default("singleton")
  nomeAttivita    String   @default("Atelier Aurora")
  telefono        String?  @default("+39 0575 889211")
  whatsappPhone   String?  @default("+39 340 000 0000")
  indirizzo       String?  @default("Via del Corso 24, Arezzo")
  mostraPrezzi    Boolean  @default(true) // Flag globale visibilità prezzi
  showcaseConfig  String   @default("{}") // JSON ShowlyConfig 100% editabile
  updatedAt       DateTime @updatedAt
}

model ProdottoCreazione {
  id                 String   @id @default(cuid())
  codice             String?  @default("AUR-001")
  titolo             String
  categoria          String   @default("Creazioni")
  specifiche         String?  // es. "Oro Giallo 750‰ • Senza Saldature"
  prezzo             String?  @default("€ 450")
  mostraPrezzo       Boolean  @default(true) // Override locale prezzo
  visibilita         String   @default("PUBBLICO") // "PUBBLICO" | "CASSAFORTE" | "NASCOSTO"
  inEvidenza         Boolean  @default(false) // Compare nella ShowGallery
  ordineVetrina      Int      @default(0)
  fotoPrincipale     String   // URL o DataURL WebP foto principale
  fotoStillLife      String?  @default("[]") // JSON array foto angolazioni secondarie
  posX               Int      @default(50) // 0..100 (object-position X%)
  posY               Int      @default(50) // 0..100 (object-position Y%)
  zoom               Float    @default(1.0) // 1.0..2.0 (scale)
  disponibile        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InvitoCassaforte {
  id                   String   @id @default(cuid())
  token                String   @unique
  nomeDestinatario     String
  whatsappDestinatario String?
  pinAccesso           String?  // PIN opzionale es. "4829"
  notaRiservata        String?
  articoliIds          String   @default("[]") // JSON array di ID ProdottoCreazione (vuoto = tutti i pezzi CASSAFORTE)
  mostraPrezzi         Boolean  @default(true)
  vincolaDispositivo   Boolean  @default(true) // Se true, si lega al primo dispositivo che lo apre
  deviceFingerprint    String?  // Hash dispositivo che ha aperto per primo il link
  maxAperture          Int      @default(10) // 0 = illimitate entro scadenza
  apertureEffettuate   Int      @default(0)
  ultimoAccesso        DateTime?
  scadenza             DateTime
  attivo               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PrenotazioneCamerino {
  id            String   @id @default(cuid())
  nomeCliente   String
  whatsapp      String
  titoloPezzo   String
  specifica     String?
  prezzo        String?
  stato         String   @default("IN_ATTESA") // "IN_ATTESA" | "PRONTO" | "RITIRATO" | "SCADUTO"
  note          String?
  dataScadenza  DateTime // Creato automaticamente a now() + 24 ore
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TrustedDevice {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash   String   // Hash fingerprint browser/dispositivo
  deviceName   String   // es. "iPhone 15 • Safari" o "Windows • Chrome"
  ipAddress    String
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, deviceHash])
}

model AccessLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evento       String   // "LOGIN_SUCCESS", "LOGIN_FAILED", "MFA_CHALLENGE", "MFA_SUCCESS", "LOGOUT"
  ipAddress    String
  userAgent    String?
  isNewDevice  Boolean  @default(false)
  createdAt    DateTime @default(now())
}
